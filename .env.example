# 필수 — 네이버 검색 API (설정 화면 /naver 에서 등록해도 됩니다)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택 — 소제목 AI 분류 (없으면 규칙 기반으로 동작, 설정 화면 /llm 에서 등록해도 됩니다)
ANTHROPIC_API_KEY=

# 선택 — 텔레그램 발송 (받는 사람은 설정 화면 /telegram 에서 등록)
TELEGRAM_BOT_TOKEN=

# 선택 — 이메일 발송 (받는 사람은 설정 화면 /email 에서 등록, 비밀번호는 앱 비밀번호)
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_PASSWORD=
